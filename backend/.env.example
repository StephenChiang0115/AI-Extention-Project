# 模型來源：mock（假資料，不需模型）／lmstudio（本機 LM Studio）／gemini（尚未實作）
PROVIDER=mock

# ---- LM Studio（PROVIDER=lmstudio 時使用）----
# LM Studio 本機伺服器位址（Developer 分頁 → Start Server，預設 port 1234）
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# 模型名稱；留空則自動使用 LM Studio 目前載入的模型。必須是支援圖片輸入的模型
LMSTUDIO_MODEL=
# 單次辨識的逾時秒數（本機模型較慢，第一次載入可能更久）
LMSTUDIO_TIMEOUT_S=120
# LM Studio 開啟 API 驗證時才需要
# LMSTUDIO_API_KEY=

# ---- Gemini（預留）----
# GEMINI_API_KEY=請填入（絕對不要提交到版本控制）
# GEMINI_MODEL=gemini-3.1-flash-lite

# 每日免費額度（次，只計算未命中快取的請求）
DAILY_FREE_LIMIT=5
# 快取存活秒數
CACHE_TTL_S=604800
# 感知雜湊容許差異位元數（0–64）。越大越容易命中，但誤判風險越高
HAMMING_THRESHOLD=6
# 設定後，/api/stats 需帶 X-Admin-Token
# ADMIN_TOKEN=請自行設定
# 允許的 CORS 來源（逗號分隔），例如 chrome-extension://<擴充功能 ID>。
# 未設定時只允許 chrome-extension:// 來源；用一般網頁（http://localhost:xxxx）測試時要把該網址加進來
# ALLOWED_ORIGINS=
# 框選影像亮度標準差低於此值（純色、天空、黑畫面）時不查也不寫快取
LOW_TEXTURE_STDDEV=8

# ---- 雲端部署（Render + Neon + Gemini）----
# 雲端上的值請在 Render 控制台的 Environment 設定，不要寫在任何會提交的檔案裡。
# 金鑰與連線字串（DATABASE_URL、LMSTUDIO_API_KEY、ADMIN_TOKEN）只放 Render 控制台或本機 backend/.env。
# 儲存層：memory（預設，重啟即清空）／postgres（需要 DATABASE_URL）
# STORE=postgres
# 原始請求紀錄保留天數（之前的會彙總成每日統計後刪除，守住 Neon 1 GB）
# LOG_RETENTION_DAYS=14
# Neon 的 pooled 連線字串（主機名稱含 -pooler），必須帶 sslmode=require
# DATABASE_URL=postgresql://使用者:密碼@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# 線上模型：Gemini 2.5 Flash-Lite，透過 OpenAI 相容端點，沿用 LM Studio Provider
# PROVIDER=lmstudio
# LMSTUDIO_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LMSTUDIO_MODEL=gemini-2.5-flash-lite
# LMSTUDIO_API_KEY=Google AI Studio 金鑰（只放 Render 控制台）
# 選用：關閉 Gemini 的思考，避免思考 token 吃掉輸出上限導致 JSON 被截斷。尚未實測，若 Gemini 回 400 就拿掉
# LMSTUDIO_REASONING_EFFORT=none
# 課堂展示改用本機 LM Studio（經 ngrok／Cloudflare 通道，LM Studio 必須開啟 API 金鑰驗證）：
# LMSTUDIO_BASE_URL=https://你的通道網域/v1
# LMSTUDIO_MODEL=LM Studio 中的模型名稱
