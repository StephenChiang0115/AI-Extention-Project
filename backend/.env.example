# 模型來源：mock（假資料，不需模型）／lmstudio（本機 LM Studio）／gemini（尚未實作）
PROVIDER=mock

# ---- LM Studio（PROVIDER=lmstudio 時使用）----
# LM Studio 本機伺服器位址（Developer 分頁 → Start Server，預設 port 1234）
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# 模型名稱；留空則自動使用 LM Studio 目前載入的模型。必須是支援圖片輸入的模型
LMSTUDIO_MODEL=
# 單次辨識的逾時秒數（本機模型較慢，第一次載入可能更久）
LMSTUDIO_TIMEOUT_S=120
# LM Studio 開啟 API 驗證時才需要
# LMSTUDIO_API_KEY=

# ---- Gemini（預留）----
# GEMINI_API_KEY=請填入（絕對不要提交到版本控制）
# GEMINI_MODEL=gemini-3.1-flash-lite

# 每日免費額度（次，只計算未命中快取的請求）
DAILY_FREE_LIMIT=5
# 快取存活秒數
CACHE_TTL_S=604800
# 感知雜湊容許差異位元數（0–64）。越大越容易命中，但誤判風險越高
HAMMING_THRESHOLD=6
# 設定後，/api/stats 需帶 X-Admin-Token
# ADMIN_TOKEN=請自行設定
# 允許的 CORS 來源（逗號分隔），例如 chrome-extension://<擴充功能 ID>。
# 未設定時只允許 chrome-extension:// 來源；用一般網頁（http://localhost:xxxx）測試時要把該網址加進來
# ALLOWED_ORIGINS=
# 框選影像亮度標準差低於此值（純色、天空、黑畫面）時不查也不寫快取
LOW_TEXTURE_STDDEV=8
