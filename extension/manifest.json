{
  "manifest_version": 3,
  "name": "AI 景點導覽精靈",
  "description": "在任何網頁框選地標，由 AI 角色即時辨識並導覽。",
  "version": "0.1.0",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost:8080/*", "http://127.0.0.1:8080/*", "https://*.onrender.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "啟用景點導覽精靈" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+L" }, "description": "啟用／關閉導覽精靈" }
  },
  "options_page": "options.html"
}
